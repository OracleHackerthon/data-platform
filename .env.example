# 키 이름 목록. 실제 값은 절대 커밋하지 않는다.
# - VM / docker compose: deploy/.env 로 복사
# - 로컬 web 개발: web/.env.local 로 복사 (AI_SERVICE_URL=http://localhost:8000)
# - 로컬 ai 개발: ai/.env 로 복사

# OpenAI: 주최 측 키는 VM 의 deploy/.env 에만 넣는다. 로컬(web/.env.local, ai/.env)에서는 비워 둔다 (DECISIONS D15)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# web -> ai 내부 주소 (compose 에서는 자동 설정됨)
AI_SERVICE_URL=http://localhost:8000

# 로컬 화면 개발용 (web/.env.local 에만): 값이 있으면 npm run dev 에서 /api/* 를 이 주소(배포본)로 보낸다. 배포 빌드에서는 무시된다
DEV_API_PROXY=

# Autonomous DB (지갑 없는 TLS 접속 문자열). 앱은 ADMIN 이 아니라 APP 사용자로 접속한다.
# 로컬에서 DB 값이 필요한 사람은 영진뿐이다 (web/.env.local). 정민에게 직접 받는다.
DB_USER=
DB_PASSWORD=
DB_CONNECT_STRING=

# Caddy: ":80" 이면 HTTP, 도메인이면 HTTPS
SITE_ADDRESS=:80
